# Nextora Technologies — Hostinger (Apache / LiteSpeed)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Force HTTPS and the www host (comment out the www block if you prefer the bare domain)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Optional: send the bare domain to www. Uncomment once www is set up in hPanel → Domains.
  # RewriteCond %{HTTP_HOST} ^nextoratechnologies\.com$ [NC]
  # RewriteRule ^ https://www.nextoratechnologies.com%{REQUEST_URI} [L,R=301]

  # Never serve repo housekeeping files
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule ^(README\.md|\.gitignore)$ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching: assets are versioned with ?v=1 in index.html — bump it when you change CSS/JS
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
</IfModule>
